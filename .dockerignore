# Docker matches these relative to the build-context root; the **/ prefix is
# what excludes nested copies (backend/db.sqlite3, backend/media/, ...).
.git
.gitignore
**/venv/
**/.venv/
**/__pycache__/
**/*.py[cod]
**/*$py.class
**/db.sqlite3
**/db.sqlite3-journal
**/media/
**/staticfiles/
**/node_modules/
**/.env
**/.env.*
!**/.env.example
**/.DS_Store
**/*.log
.prod_secret
